<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>keyupMusic4.Program</StartupObject>
    <ApplicationIcon>Assets\b.ico</ApplicationIcon>
    <PackageIcon></PackageIcon>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <UseWPF>False</UseWPF>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <SignAssembly>True</SignAssembly>
    <RootNamespace>keyupMusic4</RootNamespace>
    <!-- 项目历史风格：小写类型名、fire-and-forget 异步调用、nullable 关闭、WebView2 包冲突、nullable 注解残留 -->
    <NoWarn>$(NoWarn);CS8981;CS4014;MSB3277;CS8632</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="keyupMusic3\**" />
    <Compile Remove="mouse_hook_douyin_game\**" />
    <EmbeddedResource Remove="keyupMusic3\**" />
    <EmbeddedResource Remove="mouse_hook_douyin_game\**" />
    <None Remove="keyupMusic3\**" />
    <None Remove="mouse_hook_douyin_game\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove=".gitattributes" />
    <None Remove=".gitignore" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\b.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="org.k2fsa.sherpa.ncnn" Version="2.1.13" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
	  <Exec Command="taskkill /im keyupmusic4.exe /f" ContinueOnError="true" />
  </Target>

  <!-- 生成后事件：编译成功后启动程序（工作目录设为输出目录，保证 config.txt/image 路径正确）
       注意1：start 的第一个引号参数必须是空标题 ""，非空标题会被 cmd 解析为窗口匹配导致不启动；
       注意2：$(TargetPath) 是 DLL，必须用 $(TargetDir)$(TargetName).exe 指向 AppHost 可执行文件；
       注意3：用 Start-Process 启动并立即退出，避免 MSBuild 因常驻程序继承句柄而挂起等待 -->
  <Target Name="PostBuild" AfterTargets="Build">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;Start-Process -FilePath '$(TargetDir)$(TargetName).exe' -WorkingDirectory '$(TargetDir)'&quot;" ContinueOnError="true" />
  </Target>

</Project>